# Copy to config.env, or set PROXY_CONFIG to an external file's path.
# Both bundle exec ruby stats.rb and sh install.sh read this config.
PROXY_SSH_TARGET='deploy@proxy.example.com'
PROXY_APP='example-proxy'
PROXY_PAGE_DIR='/srv/example-proxy/public'
PROXY_NGINX_CONFIG='/srv/example-proxy/nginx/public-access.conf'
PROXY_BACKUP_DIR='/srv/example-proxy/backups'
PROXY_FILE_OWNER='deploy'
PROXY_FILE_GROUP='deploy'
